# Pacotes
library(quantmod)
library(forecast)
library(rugarch)
library(mfGARCH)
library(broom)


# Dados -------------------------------------------------------------------

# Log-retorno Ibovespa 03-01-2000 a 30-12-2025
r_ibov <- readRDS(file = 'dados/retorno_ibovespa.rds')

# Indice GPR Brasil 01-2000 a 01-2026
gpr <- readRDS( file = 'dados/indice_GPR_BRA.rds')


# Unindo as bases
base <- left_join(
  x = r_ibov,
  y = gpr,
  by = 'mes_ano'
) |> rename(date = data )



# Estimação In-Sample -----------------------------------------------------

# Amostra
base_in_sample <- base |> dplyr::filter(date <= '2022-12-31')

gpr_m <- base_in_sample %>%
  distinct(mes_ano, GPRC_BRA)   # 1 valor por mês

gpr_mean <- mean(gpr_m$GPRC_BRA, na.rm = TRUE)

base_in_sample <- base_in_sample %>%
  mutate(GPR_BRA_S = ifelse(GPRC_BRA > gpr_mean, GPRC_BRA, 0))



# 1. Ajustar um modelo AR(1) simples nos retornos
modelo_ar <- arima(base_in_sample$retorno, order = c(1, 0, 0))

# 2. Extrair os resíduos (o que o AR não explicou)
base_in_sample$residuos_ar <- residuals(modelo_ar)

library(lubridate)
base_in_sample$mes_ano <- ymd(paste0(base_in_sample$mes_ano, "-01"))

# 3. Rodar o GARCH-MIDAS sobre os resíduos em vez dos retornos brutos
m_1 <- fit_mfgarch(
  data = as.data.frame(base_in_sample),
  y = 'retorno',  # Usamos o "erro" limpo do AR
  x = 'GPR_FINAL',
  low.freq = 'mes_ano',
  K = 12,
  weighting = "beta.restricted",
  gamma = FALSE
)

m_1$broom.mgarch

# 1. Extração da Volatilidade de Longo Prazo (Tau)
# Multiplicamos por 100 se os retornos estiverem em base 100 para manter a escala
df_grafico <- data.frame(
  data = as.Date(base_in_sample$date),
  retorno = base_in_sample$retorno,
  tau = sqrt(m_1$tau) 
)

mean(base_in_sample$GPRC_BRA)
