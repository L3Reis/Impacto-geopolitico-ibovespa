# Acesso aos Valores Estimados:

garch.fit@model	# Par?metros Definidos do Modelo
garch.fit@fit	# Resultado das Estima??es

tsdisplay(garch.fit@fit$residuals)	# Res?duos do Modelo da M?dia Condicional 
tsdisplay(garch.fit@fit$z)	  	# Res?duos do Modelo da Vari?ncia Condicional 
tsdisplay(garch.fit@fit$z^2)		# Res?duos do Modelo da Vari?ncia Condicional 


###################################################################################################################################################
# Especificacao ARMA(p,q)-EGARCH(m,s): usar "eGARCH" para o modelo da variancia
###################################################################################################################################################

egarch.spec <- ugarchspec(variance.model = list(model = "eGARCH", garchOrder = c(2,1)), mean.model = list(armaOrder = c(0, 0), include.mean = TRUE))

egarch.fit <- ugarchfit(egarch.spec, data=r.TSLA)	# Ordem do Gamma = ordem ARCH	
egarch.fit    # gamma is the leverage effect term
plot(egarch.fit, which=11)



###################################################################################################################################################
# Especificacao ARMA(p,q)-TARCH(m,s): usar "gjrGARCH" para o modelo da variancia
###################################################################################################################################################

tarch.spec <- ?ugarchspec(variance.model = list(model = "gjrGARCH", garchOrder = c(2, 1)), mean.model = list(armaOrder = c(0, 0), include.mean = FALSE), distribution.model = "norm")
tarch.fit <- ugarchfit(tarch.spec, data=r.TSLA)	  # gamma is the leverage effect term
tarch.fit

plot(tarch.fit, which=11)


###################################################################################################################################################
# Especifica??o ARMA(p,q)-APARCH(m,s): usar "apARCH" para o modelo da vari?ncia
###################################################################################################################################################

aparch.spec <- ugarchspec(variance.model = list(model = "apARCH", garchOrder = c(2,1)), mean.model = list(armaOrder = c(0, 0), include.mean = TRUE))
aparch.fit <- ugarchfit(aparch.spec, data=r.TSLA)	# Conclus?o: gamma n?o significativo => n?o tem leverage effect na s?rie da TSLA
aparch.fit
plot(aparch.fit, which=11)


###################################################################################################################################################
# Previsao com Modelos GARCH
###################################################################################################################################################

garch.forec <- ugarchforecast(garch.fit, n.ahead=20, n.roll = 0)
sigma(garch.forec)
fitted(garch.forec)
plot(garch.forec)

tarch.forec <- ?ugarchforecast(tarch.fit)
head(sigma(tarch.forec))
head(fitted(tarch.forec))
plot(garch.forec)

