# Obtendo dados:
SOL1-USD
getSymbols("TSLA", from="2020-01-01", to="2020-12-31") # Download daily prices of Tesla stock from Yahoo
candleChart(TSLA, multi.col=TRUE, theme="white")
dim(TSLA)
	
r.TSLA <- dailyReturn(TSLA, type="log")			# ou type="arithmetic"); Igualmente: r.TSLA <- diff(log(Close))
plot.ts(r.TSLA)
tsdisplay(r.TSLA)
tsdisplay(r.TSLA^2)

###################################################################################################################################################
# Testes para Autocorrelacao Serial e para Heterocedasticidade
###################################################################################################################################################

# Teste de Box-Pierce ou Ljung-Box - H0: Nao Existe autocorrelacao na serie 

Box.test(r.TSLA, 12, type="Ljung-Box")
Box.test(r.TSLA^2, 12, type="Ljung-Box")

# Teste de Heterocedasticidade (LM)- H0: Nao existe Heterocedasticidade

ArchTest(r.TSLA, lags=6, demean = TRUE)	

###################################################################################################################################################
# Especificacao ARMA(p,q)-GARCH(m,s): usar "sGARCH" para o modelo da variancia
###################################################################################################################################################

# Especificacao do modelo:
?ugarchspec
garch.spec <- ugarchspec(variance.model = list(model = "sGARCH", garchOrder = c(1,1)), mean.model = list(armaOrder = c(0,0), include.mean = TRUE))

# Estimacao do Modelo GARCH:
?ugarchfit
garch.fit <- ugarchfit(garch.spec, data=r.TSLA) # Obs: omega é o intercepto da variância.
garch.fit

slotNames(garch.fit)
names(garch.fit@fit)
names(garch.fit@model)

coef(garch.fit)
infocriteria(garch.fit)
likelihood(garch.fit)
nyblom(garch.fit)
signbias(garch.fit)
head(sigma(garch.fit))
head(residuals(garch.fit))
head(fitted(garch.fit))
gof(garch.fit,c(20,30,40,50))
uncmean(garch.fit)
uncvariance(garch.fit)

plot(garch.fit, which="all")
plot(garch.fit, which=10)
plot(garch.fit, which=11)


tsdisplay(garch.fit@fit$z)	  	# Residuos padronizados do Modelo da Media Condicional 
tsdisplay(garch.fit@fit$z^2)		# Residuos padronizados do Modelo da Variancia Condicional 


# ARCH(2)
Akaike       -2.9969
Bayes        -2.9409
