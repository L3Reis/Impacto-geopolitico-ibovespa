# APPLE
##########################################################################################################################################

getSymbols("AAPL", from="2022-01-01", to="2023-12-01") # Download daily prices of Tesla stock from Yahoo
candleChart(AAPL, multi.col=TRUE, theme="white")

r.AAPL <- dailyReturn(AAPL, type="log")			# ou type="arithmetic"); Igualmente: r.TSLA <- diff(log(Close))
tsdisplay(r.AAPL)
tsdisplay(r.AAPL^2, lag.max = 36)

# Teste de Heterocedasticidade (LM)- H0: Nao existe Heterocedasticidade

ArchTest(r.AAPL, lags=6, demean = TRUE)	

###################################################################################################################################################
# Especificacao ARMA(p,q)-GARCH(m,s): usar "sGARCH" para o modelo da variancia
###################################################################################################################################################

# Especificacao do modelo:
?ugarchspec
?ugarchfit
garch.spec <- ugarchspec(variance.model = list(model = "sGARCH", garchOrder = c(6,0)), mean.model = list(armaOrder = c(1,1), include.mean = FALSE),distribution.model = "std")
garch.fit <- ugarchfit(garch.spec, data=r.AAPL) # Obs: omega é o intercepto da variância.
garch.fit


plot(garch.fit, which="all")
plot(garch.fit, which=11)
plot(garch.fit, which=10)


###################################################################################################################################################
# Especificacao ARMA(p,q)-EGARCH(m,s): usar "eGARCH" para o modelo da variancia
###################################################################################################################################################

egarch.spec <- ugarchspec(variance.model = list(model = "eGARCH", garchOrder = c(6,1)), mean.model = list(armaOrder = c(2,2), include.mean = TRUE), distribution.model = "std")

egarch.fit <- ugarchfit(egarch.spec, data=r.AAPL)	# Ordem do Gamma = ordem ARCH	
egarch.fit    # Obs: alpha captures de sign effect and gamma the size effect; i.e, if alpha not significant => no leverage effect
plot(egarch.fit, which="all")


###################################################################################################################################################
# Especificacao ARMA(p,q)-TARCH(m,s): usar "gjrGARCH" para o modelo da variancia
###################################################################################################################################################

tarch.spec <- ugarchspec(variance.model = list(model = "gjrGARCH", garchOrder = c(1, 1)), mean.model = list(armaOrder = c(0, 0), include.mean = FALSE), distribution.model = "std")

tarch.fit <- ugarchfit(tarch.spec, data=r.AAPL)	  # gamma is the leverage effect term
tarch.fit

plot(tarch.fit, which="all")


###################################################################################################################################################
# Especifica??o ARMA(p,q)-APARCH(m,s): usar "apARCH" para o modelo da vari?ncia
###################################################################################################################################################

aparch.spec <- ugarchspec(variance.model = list(model = "apARCH", garchOrder = c(1,1)), mean.model = list(armaOrder = c(0, 0), include.mean = FALSE), distribution.model = "std")
aparch.fit <- ugarchfit(aparch.spec, data=r.AAPL)	# Conclus?o: gamma n?o significativo => n?o tem leverage effect na s?rie da TSLA
aparch.fit
plot(aparch.fit, which="all")


